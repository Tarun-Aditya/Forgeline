{
  "spec_approval": "human",
  "intent_required": true,
  "max_resumes": 2,
  "authorization_env": "FACTORY_RELEASE_AUTHORIZED",
  "frozen_paths": [
    ".claude/**",
    ".env*",
    "**/*.pem",
    "**/*.key",
    ".github/CODEOWNERS",
    "factory/policy.json",
    "factory/scripts/**",
    "factory/templates/**",
    "factory/REVIEW.md",
    "factory/audit/**",
    "factory/constraints.json",
    "factory/out-of-scope.md",
    "factory/DEFINITION_OF_DONE.md",
    "factory/checklists/**"
  ],
  "escalate_paths": [
    ".github/**",
    ".gitlab-ci.yml",
    "Jenkinsfile",
    "azure-pipelines.yml",
    "deploy*",
    "scripts/deploy*",
    "Dockerfile*",
    "docker-compose*.yml",
    "**/migrations/**",
    "**/*.tf",
    "firebase.json",
    "firestore.rules",
    "storage.rules",
    "**/helm/**",
    "**/k8s/**"
  ],
  "dependency_files": [
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "requirements*.txt",
    "pyproject.toml",
    "poetry.lock",
    "go.mod",
    "go.sum",
    "Gemfile",
    "Gemfile.lock",
    "pom.xml",
    "build.gradle",
    "build.gradle.kts",
    "Cargo.toml",
    "Cargo.lock",
    "composer.json"
  ],
  "test_globs": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/test/**",
    "**/tests/**",
    "**/__tests__/**",
    "test_*.py",
    "**/test_*.py",
    "*_test.py",
    "**/*_test.py",
    "*_test.go",
    "**/*_test.go"
  ],
  "blocked_commands": [
    "git(\\s+(-C|-c)\\s+\\S+|\\s+--[\\w-]+(=\\S+)?)*\\s+push\\b",
    "git\\s+remote\\s+(add|set-url)",
    "npm\\s+publish",
    "terraform\\s+(apply|destroy)",
    "kubectl\\s+(apply|delete|rollout)",
    "helm\\s+(install|upgrade|uninstall)",
    "docker\\s+push",
    "curl[^|;&]*\\|\\s*(ba)?sh",
    "wget[^|;&]*\\|\\s*(ba)?sh",
    "git(\\s+(-C|-c)\\s+\\S+|\\s+--[\\w-]+(=\\S+)?)*\\s+merge(?![\\w-])[^\\n;&|]*\\bfactory/",
    "git(\\s+(-C|-c)\\s+\\S+|\\s+--[\\w-]+(=\\S+)?)*\\s+reset\\s+(\\S+\\s+)*--hard",
    "git(\\s+(-C|-c)\\s+\\S+|\\s+--[\\w-]+(=\\S+)?)*\\s+clean\\s+-\\w*f",
    "git(\\s+(-C|-c)\\s+\\S+|\\s+--[\\w-]+(=\\S+)?)*\\s+branch\\s+(\\S+\\s+)*-D\\b",
    "git(\\s+(-C|-c)\\s+\\S+|\\s+--[\\w-]+(=\\S+)?)*\\s+(checkout|restore)\\s+(\\S+\\s+)*\\.(\\s|$)",
    "git(\\s+(-C|-c)\\s+\\S+|\\s+--[\\w-]+(=\\S+)?)*\\s+stash\\s+(drop|clear)",
    "\\brm\\s+-\\w*[rR]\\w*\\s+(-\\w+\\s+)*(/|~|\\$HOME)(\\s|/?$)"
  ],
  "ticketing": {
    "system": null,
    "key_pattern": "[A-Z][A-Z0-9]+-[0-9]+",
    "mcp_server": null
  },
  "merge_policy": {
    "auto_max_lines": 400,
    "size_exclude": [
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/yarn.lock",
      "**/*.lock",
      "**/*.snap",
      "dist/**",
      "factory/audit/**"
    ],
    "verify_commands": [],
    "require_verify": false,
    "lock_stale_minutes": 60,
    "constraints": [],
    "max_auto_packages": 3,
    "check_baseline": true,
    "callers_widen": true
  },
  "adr": {
    "dir": "docs/adr"
  },
  "packages": []
}
